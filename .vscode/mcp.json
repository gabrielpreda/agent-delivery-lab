{
  "servers": {
    "jira": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://build-with-ai.atlassian.net",
        "JIRA_USERNAME": "${env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "${env:JIRA_API_TOKEN}"
      }
    },
    "miro": {
      "type": "http",
      "url": "https://mcp.miro.com/"
    },
    "figma": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "figma-developer-mcp@0.13.2", "--stdio"],
      "envFile": "${workspaceFolder}/.env"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "cloud_run": {
      "type": "http",
      "url": "https://run.googleapis.com/mcp"
    },
    "google_developer_knowledge": {
      "type": "http",
      "url": "https://developerknowledge.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${input:google_developer_knowledge_api_key}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "google_developer_knowledge_api_key",
      "description": "Google Developer Knowledge API key",
      "password": true
    }
  ]
}
